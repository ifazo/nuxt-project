    "@nuxtjs/dotenv": "^1.4.2",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@pinia/nuxt": "^0.10.1",
    "@prisma/client": "^6.5.0",
    "@stripe/stripe-js": "^7.1.0",
    "@tailwindcss/vite": "^4.1.3",
    "@vueup/vue-quill": "^1.2.0",
    "firebase": "^11.6.0",
    "nuxt": "^3.16.2",
    "pinia": "^3.0.1",
    "prisma": "^6.5.0",
    "stripe": "^18.0.0",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.34",
    "@nuxt/eslint": "^1.3.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}

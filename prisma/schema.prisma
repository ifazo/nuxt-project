// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

model User {
  id       String   @id @default(uuid())
  name     String?
  image    String?
  email    String   @unique
  password String?
  role     UserRole @default(BUYER)

  createdAt     DateTime?       @default(now())
  updatedAt     DateTime?       @updatedAt
  order         Order[]
  wishlist      Wishlist[]
  blog          Blog[]
  shop          Shop?
  productReview ProductReview[]

  @@map("users")
}

model Category {
  id      String @id @default(uuid())
  name    String @unique
  details String
  icon    String

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  product   Product[]

  @@map("categories")
}

model Shop {
  id        String @id @default(uuid())
  name      String @unique
  details   String
  logo      String
  userEmail String @unique @map("user")
  user      User   @relation(fields: [userEmail], references: [email])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  product   Product[]

  @@map("shops")
}

model Product {
  id           String   @id @default(uuid())
  title        String
  images       String[]
  description  String
  highlights   String[]
  price        Float
  stock        Int
  tags         String[]
  categoryName String   @map("category")
  category     Category @relation(fields: [categoryName], references: [name])
  shopName     String   @map("shop")
  shop         Shop     @relation(fields: [shopName], references: [name])

  createdAt     DateTime?       @default(now())
  updatedAt     DateTime?       @updatedAt
  wishlist      Wishlist[]
  productReview ProductReview[]

  @@map("products")
}

model ProductReview {
  id        String  @id @default(uuid())
  rating    Int
  comment   String
  userEmail String  @map("user")
  user      User    @relation(fields: [userEmail], references: [email])
  productId String  @map("product")
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("product_reviews")
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  description String
  content     String
  image       String
  tags        String[]
  userEmail   String   @map("user")
  user        User     @relation(fields: [userEmail], references: [email])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("blogs")
}

model Wishlist {
  id        String  @id @default(uuid())
  userEmail String  @map("user")
  user      User    @relation(fields: [userEmail], references: [email])
  productId String  @map("product")
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("wishlists")
}

model Order {
  id         String      @id @default(uuid())
  products   Json[]
  total      Float
  status     OrderStatus @default(PAID)
  sessionId  String      @map("session_id")
  customerId String      @map("customer_id")
  userEmail  String      @map("user")
  user       User        @relation(fields: [userEmail], references: [email])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

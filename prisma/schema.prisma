generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

model User {
  id             String          @id @default(uuid())
  name           String?
  image          String?
  email          String          @unique
  password       String?
  role           UserRole        @default(BUYER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orders         Order[]
  wishlists      Wishlist[]
  blogs          Blog[]
  shop           Shop?
  productReviews ProductReview[]
  blogReviews    BlogReview[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  details   String
  icon      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Shop {
  id        String    @id @default(uuid())
  name      String    @unique
  details   String
  logo      String
  userEmail String    @unique @map("user")
  user      User      @relation(fields: [userEmail], references: [email])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("shops")
}

model Product {
  id             String          @id @default(uuid())
  title          String
  images         String[]
  description    String
  highlights     String[]
  price          Float
  stock          Int
  tags           String[]
  categoryName   String          @map("category")
  category       Category        @relation(fields: [categoryName], references: [name], onDelete: Cascade)
  shopName       String          @map("shop")
  shop           Shop            @relation(fields: [shopName], references: [name], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wishlists      Wishlist[]
  productReviews ProductReview[]

  @@map("products")
}

model ProductReview {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  userEmail String   @map("user")
  user      User     @relation(fields: [userEmail], references: [email])
  productId String   @map("product")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_reviews")
}

model Blog {
  id          String       @id @default(uuid())
  title       String
  description String
  content     String
  image       String
  tags        String[]
  userEmail   String       @map("user")
  user        User         @relation(fields: [userEmail], references: [email])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  blogReviews BlogReview[]

  @@map("blogs")
}

model BlogReview {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  userEmail String   @map("user")
  user      User     @relation(fields: [userEmail], references: [email])
  blogId    String   @map("blog")
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userEmail String   @map("user")
  user      User     @relation(fields: [userEmail], references: [email])
  productId String   @map("product")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlists")
}

model Order {
  id         String      @id @default(uuid())
  products   Json[]
  total      Float
  status     OrderStatus @default(PAID)
  sessionId  String      @map("session_id")
  customerId String      @map("customer_id")
  userEmail  String      @map("user")
  user       User        @relation(fields: [userEmail], references: [email])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}
